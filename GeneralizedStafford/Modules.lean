module

public import GeneralizedStafford.CorollaryB

@[expose] public section

/-!
# Corollary C: module consequences (C.1, C.1 stable form, C.2)

Assume (S), (N), (Z); zero divisors are allowed.

**C.1, stable form** (`span_pair_eq_span_affine`). If `c, u` are killed by regular
elements and `Kdim(uR)` is finite, then for every `t ≠ 0` there is `H` with
`cR + uR = (c + u H t)R`. Proof: choose a regular `b` with `c b = 0`. Since
`uR ≅ R/ann(u)` and `ann(u)` contains a regular element, Theorem A' with offset
`0` and tail `t b ≠ 0` gives `1 = i + H t b r` with `u i = 0`. For
`z = c + u H t` this gives `z (b r) = u H t b r = u`, so `u ∈ zR`, and then
`c = z - u H t ∈ zR`.

**C.1** (`prescribed_cyclic`). A finitely generated Goldie-torsion module `M`
with `Kdim M` finite satisfies `M = (x + h t)R` for every `x` and `t ≠ 0`.
Proof: induction on a finite generating set (`prescribed_cyclic_aux`); a new
generator `u` is absorbed into the current affine generator `c = x + y t` by the
stable form, with `h = y + u H`. Under (H_all) every cyclic submodule `uR ≅ R/ann(u)`
is a quotient of `R/sR` for a regular `s` killing `u`, so the dimension hypothesis
is automatic (`prescribed_cyclic_of_hAll`, and `prescribed_cyclic_of_devLE_omega`
under `Kdim R ≤ ω` by Corollary B).

**C.2** (`two_generated_prescribed`, `two_generated`). Under (H_all), if `a ∈ I`
has full rank (every `y ∈ I` has a regular `s` with `y s ∈ aR`, the elementwise
form of `aQ = IQ`), then `I/aR` is a finitely generated Goldie-torsion module, and
C.1 applied to `y + aR` gives `h ∈ I` with `I = aR + (y + h t)R`. Such an `a`
exists in every right ideal by Goldie's theorem
(`AlgebraicAnalysis.Goldie.exists_mem_forall_exists_mul_mem`), so every right ideal
is generated by two elements.
-/

namespace GeneralizedStafford

open MulOpposite nonZeroDivisors
open AlgebraicAnalysis AlgebraicAnalysis.Goldie AlgebraicAnalysis.DenominatorTorsion

universe u v

variable {R : Type u} [Ring R] [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
variable {k : Type*} [Field k] [Infinite k] [Algebra k R]

/-! ## C.1, stable form -/

section Stable

variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]

include k in
/-- **C.1, stable cyclicity.** If `c, u ∈ M` are
killed by regular elements of `R` and `Kdim(uR)` is finite, then for every
`t ≠ 0` there is `H` with `cR + uR = (c + u H t)R`. -/
theorem span_pair_eq_span_affine (c u : M)
    (hc : ∃ s ∈ R⁰, op s • c = 0) (hu : ∃ s ∈ R⁰, op s • u = 0)
    (hfin : ∃ N, Module.DevLE Rᵐᵒᵖ N (Submodule.span Rᵐᵒᵖ {u}))
    {t : R} (ht : t ≠ 0) :
    ∃ H : R, Submodule.span Rᵐᵒᵖ {c, u} =
      Submodule.span Rᵐᵒᵖ {c + op (H * t) • u} := by
  classical
  obtain ⟨b, hb, hcb⟩ := hc
  obtain ⟨N, hN⟩ := hfin
  obtain ⟨s₀, hs₀, hs₀u⟩ := hu
  -- One call of Theorem A' for `ann(u)`, with offset `0` and tail `t b ≠ 0`.
  obtain ⟨H, hH⟩ := fixed_ideal (k := k) (I := LinearMap.ker (cyclicMap (R := R) u))
    ⟨s₀, hs₀u, hs₀⟩ ((devLE_quotient_ker_cyclicMap_iff N u).mpr hN) 0 (t := t * b)
    (fun h0 => ht (hb.2 t h0))
  rw [zero_add] at hH
  have h1 : (1 : R) ∈ LinearMap.ker (cyclicMap (R := R) u) ⊔
      principalRightIdeal (H * (t * b)) := by
    rw [hH]; exact Submodule.mem_top
  obtain ⟨i, hi, w, ⟨r, rfl⟩, hiw⟩ := Submodule.mem_sup.mp h1
  -- The element `z = c + u H t` generates `u`: `u = z (b r)`.
  set z := c + op (H * t) • u with hz
  have hu_eq : op (b * r) • z = u := by
    have h := congrArg (cyclicMap (R := R) u) hiw
    change op (i + H * (t * b) * r : R) • u = op (1 : R) • u at h
    rw [op_one, one_smul, op_add, add_smul] at h
    change cyclicMap (R := R) u i + _ = u at h
    rw [LinearMap.mem_ker.mp hi, zero_add] at h
    have e1 : op (b * r) • c = 0 := by rw [op_mul, mul_smul, hcb, smul_zero]
    have e2 : op (b * r) • (op (H * t) • u) = op (H * (t * b) * r) • u := by
      simp only [op_mul, mul_smul, mul_assoc]
    rw [hz, smul_add, e1, e2, zero_add, h]
  have huz : u ∈ Submodule.span Rᵐᵒᵖ {z} := by
    rw [← hu_eq]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self z)
  -- Hence also `c = z - u H t ∈ zR`.
  have hcz : c ∈ Submodule.span Rᵐᵒᵖ {z} := by
    have hc' : c = z - op (H * t) • u := by rw [hz, add_sub_cancel_right]
    rw [hc']
    exact Submodule.sub_mem _ (Submodule.mem_span_singleton_self z)
      (Submodule.smul_mem _ _ huz)
  refine ⟨H, le_antisymm ?_ ?_⟩
  · exact Submodule.span_le.mpr (Set.insert_subset_iff.mpr
      ⟨hcz, Set.singleton_subset_iff.mpr huz⟩)
  · refine Submodule.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    exact Submodule.add_mem _ (Submodule.subset_span (by simp))
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

end Stable

/-! ## C.1, prescribed cyclic generator -/

section PrescribedCyclic

variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]

include k in
/-- The induction over a finite set `s` of elements, relative to
a submodule `W`: if every cyclic submodule of the Goldie-torsion module `M`
has finite deviation and `sR + W = M`, then for every `x` and `t ≠ 0` there is
`h` with `(x + h t)R + W = M`. -/
theorem prescribed_cyclic_aux
    (hcyc : ∀ u : M, ∃ N, Module.DevLE Rᵐᵒᵖ N (Submodule.span Rᵐᵒᵖ {u}))
    (htor : IsGoldieTorsion R M) {t : R} (ht : t ≠ 0) (s : Finset M) :
    ∀ W : Submodule Rᵐᵒᵖ M, Submodule.span Rᵐᵒᵖ (s : Set M) ⊔ W = ⊤ →
      ∀ x : M, ∃ h : M, Submodule.span Rᵐᵒᵖ {x + op t • h} ⊔ W = ⊤ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro W hW x
    refine ⟨0, ?_⟩
    rw [Finset.coe_empty, Submodule.span_empty, bot_sup_eq] at hW
    rw [hW, sup_top_eq]
  | insert u s _ ih =>
    intro W hW x
    have hW' : Submodule.span Rᵐᵒᵖ (s : Set M) ⊔ (W ⊔ Submodule.span Rᵐᵒᵖ {u}) = ⊤ := by
      rw [Finset.coe_insert, Submodule.span_insert] at hW
      rw [← hW]
      ac_rfl
    -- Induction: `c = x + y t` generates `M` modulo `W + uR`.
    obtain ⟨y, hy⟩ := ih (W ⊔ Submodule.span Rᵐᵒᵖ {u}) hW' x
    -- Stable form: `cR + uR = (c + u H t)R`.
    obtain ⟨H, hH⟩ := span_pair_eq_span_affine (k := k) (x + op t • y) u
      (htor _) (htor u) (hcyc u) ht
    refine ⟨y + op H • u, ?_⟩
    have hz : x + op t • (y + op H • u) = (x + op t • y) + op (H * t) • u := by
      simp only [smul_add, op_mul, mul_smul, add_assoc]
    rw [hz, ← hH, eq_top_iff, ← hy, Submodule.span_insert]
    exact le_of_eq (by ac_rfl)

include k in
/-- C.1 when every cyclic submodule `uR` has finite deviation: a finitely
generated Goldie-torsion module `M` satisfies `M = (x + h t)R` for some `h`,
for every `x` and `t ≠ 0`. -/
theorem prescribed_cyclic_of_cyclic [Module.Finite Rᵐᵒᵖ M]
    (hcyc : ∀ u : M, ∃ N, Module.DevLE Rᵐᵒᵖ N (Submodule.span Rᵐᵒᵖ {u}))
    (htor : IsGoldieTorsion R M) (x : M) {t : R} (ht : t ≠ 0) :
    ∃ h : M, Submodule.span Rᵐᵒᵖ {x + op t • h} = ⊤ := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := Rᵐᵒᵖ) (M := M)
  obtain ⟨h, hh⟩ := prescribed_cyclic_aux (k := k) hcyc htor ht s ⊥
    (by rw [hs, top_sup_eq]) x
  exact ⟨h, by rwa [sup_bot_eq] at hh⟩

include k in
/-- **C.1.** Let `M` be a finitely
generated Goldie-torsion right module with `Kdim M ≤ N` finite. For every
`x ∈ M` and every `t ≠ 0` there is `h ∈ M` with `M = (x + h t)R`. -/
theorem prescribed_cyclic [Module.Finite Rᵐᵒᵖ M]
    (htor : IsGoldieTorsion R M) {N : ℕ} (hfin : Module.DevLE Rᵐᵒᵖ N M)
    (x : M) {t : R} (ht : t ≠ 0) :
    ∃ h : M, Submodule.span Rᵐᵒᵖ {x + op t • h} = ⊤ :=
  prescribed_cyclic_of_cyclic (k := k)
    (fun u => ⟨N, hfin.of_injective (Submodule.span Rᵐᵒᵖ {u}).subtype Subtype.val_injective⟩)
    htor x ht

include k in
/-- **C.1 under (H_all).** If `R/dR` has finite deviation for every regular
`d`, then every finitely generated Goldie-torsion module `M` satisfies
`M = (x + h t)R` for some `h`, for every `x` and `t ≠ 0`. -/
theorem prescribed_cyclic_of_hAll [Module.Finite Rᵐᵒᵖ M]
    (hall : PrincipalQuotientsFinite R)
    (htor : IsGoldieTorsion R M) (x : M) {t : R} (ht : t ≠ 0) :
    ∃ h : M, Submodule.span Rᵐᵒᵖ {x + op t • h} = ⊤ := by
  refine prescribed_cyclic_of_cyclic (k := k) (fun u => ?_) htor x ht
  obtain ⟨s, hs, hsu⟩ := htor u
  obtain ⟨N, hN⟩ := hall s hs
  exact ⟨N, (devLE_quotient_ker_cyclicMap_iff N u).mp
    (devLE_quotient_of_le hN (principalRightIdeal_le (X := LinearMap.ker (cyclicMap u)) hsu))⟩

include k in
/-- **C.1 under `Kdim R ≤ ω`** (via Corollary B). -/
theorem prescribed_cyclic_of_devLE_omega [Module.Finite Rᵐᵒᵖ M]
    (homega : Module.DevLEOmega Rᵐᵒᵖ R)
    (htor : IsGoldieTorsion R M) (x : M) {t : R} (ht : t ≠ 0) :
    ∃ h : M, Submodule.span Rᵐᵒᵖ {x + op t • h} = ⊤ :=
  prescribed_cyclic_of_hAll (k := k)
    (principalQuotientsFinite_of_devLE_omega homega) htor x ht

end PrescribedCyclic

/-! ## C.2, two-generated right ideals -/

section TwoGenerated

include k in
/-- **C.2, prescribed form.** Assume (H_all).
If `a ∈ I` and every `y ∈ I` has a regular `s` with `y s ∈ aR` (that is,
`aQ = IQ`), then for every `y ∈ I` and every `t ≠ 0` there is `h ∈ I` with
`I = aR + (y + h t)R`. -/
theorem two_generated_prescribed (hall : PrincipalQuotientsFinite R)
    {I : Submodule Rᵐᵒᵖ R} {a : R} (haI : a ∈ I)
    (hIa : ∀ y ∈ I, ∃ s ∈ R⁰, y * s ∈ principalRightIdeal a)
    {y : R} (hyI : y ∈ I) {t : R} (ht : t ≠ 0) :
    ∃ h ∈ I, I = principalRightIdeal a ⊔ principalRightIdeal (y + h * t) := by
  classical
  -- C.1 in the finitely generated Goldie-torsion module `I/aR`.
  set K := (principalRightIdeal a).comap I.subtype
  obtain ⟨hbar, hh⟩ := prescribed_cyclic_of_hAll (k := k) (M := ↥I ⧸ K) hall
    (isGoldieTorsion_quotient_of_forall_exists_mul_mem hIa) (K.mkQ ⟨y, hyI⟩) ht
  obtain ⟨⟨h, hhI⟩, rfl⟩ := Submodule.mkQ_surjective K hbar
  refine ⟨h, hhI, le_antisymm ?_ ?_⟩
  · intro m hm
    have hmem : K.mkQ ⟨m, hm⟩ ∈ Submodule.span Rᵐᵒᵖ
        {K.mkQ ⟨y, hyI⟩ + op t • K.mkQ ⟨h, hhI⟩} := by rw [hh]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
    rw [← map_smul, ← map_add, ← map_smul] at hc
    have hK : c • ((⟨y, hyI⟩ : ↥I) + op t • ⟨h, hhI⟩) - ⟨m, hm⟩ ∈ K :=
      (Submodule.Quotient.eq K).mp hc
    obtain ⟨r, hr⟩ := hK
    have hr' : a * r = (y + h * t) * unop c - m := hr
    have : m = a * (-r) + (y + h * t) * unop c := by
      rw [mul_neg, hr']; abel
    rw [this]
    exact Submodule.add_mem_sup ⟨-r, rfl⟩ ⟨unop c, rfl⟩
  · refine sup_le (principalRightIdeal_le haI) (principalRightIdeal_le ?_)
    exact I.add_mem hyI (I.smul_mem (op t) hhI)

include k in
/-- **C.2, two generators.** Under (H_all) every right
ideal is generated by two elements: `I = aR + bR`. Take `a` of full rank
(Goldie) and apply the prescribed form with `y = 0`, `t = 1`. -/
theorem two_generated (hall : PrincipalQuotientsFinite R) (I : Submodule Rᵐᵒᵖ R) :
    ∃ a b : R, I = principalRightIdeal a ⊔ principalRightIdeal b := by
  obtain ⟨a, haI, hIa⟩ := exists_mem_forall_exists_mul_mem I
  obtain ⟨h, -, hI⟩ := two_generated_prescribed (k := k) hall haI hIa I.zero_mem
    one_ne_zero
  exact ⟨a, 0 + h * 1, hI⟩

end TwoGenerated

end GeneralizedStafford
