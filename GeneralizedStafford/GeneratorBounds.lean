module

public import GeneralizedStafford.Modules
public import AlgebraicAnalysis.RingTheory.Goldie.Rank
public import AlgebraicAnalysis.RingTheory.Goldie.Idempotents
public import Mathlib.RingTheory.SimpleModule.WedderburnArtin

@[expose] public section

/-!
# Corollary C.3: generator bounds by the normalized Goldie rank

The upper bound is proved by induction on `q`, without transferring the module
to a matrix ring.

Notation. `R` satisfies (S) and (N); `Q` is its classical right quotient ring
(Goldie), `M_Q = M ⊗_R Q` the module of fractions of a finitely generated right
module `M`, `l = length_Q(M_Q)` its Goldie rank (`AlgebraicAnalysis.Goldie.goldieRank`)
and `s = length_Q(Q_Q) = goldieRank R R`, so `ρ(M) = l / s`.

**Lower bound** `⌈ρ(M)⌉ ≤ μ(M)` (`le_mul_of_span_eq_top`). If `m` elements generate
`M`, then `M_Q` is a quotient of `Q^m`, so `l ≤ m s`; by Goldie, `l = udim(M/t(M))`
and `s = udim(R_R)` (AlgebraicAnalysis `Goldie.le_mul_of_uniformDim`).

**Upper bound** `μ(M) ≤ ⌊ρ(M)⌋ + 1` (`exists_span_eq_top_of_lt_mul`), assuming also
(Z) and (H_all): if `l < q s` then `M` is generated by `q` elements, by induction
on `q` (`spanRank_le_of_goldieRank_lt`). *Base case `l < s`*
(`cyclic_of_goldieRank_lt`): with idempotents `E_i` of `Q` and
common denominators `f_i = E_i c`, `r_i = c⁻¹ E_i t_i` in `R`
(`Goldie.exists_idempotent_denominators`), choose `m_i` successively so that the
fractions of `m_i e_i`, `e_i = f_i r_i`, span `M_Q` (simplicity of `R` makes each
choice possible); then `M / Σ m_i e_i R` is Goldie torsion, and C.1 with the
unused index `l` and the tail `e_l` produces one generator `y = p + h f_l`.
*Step `l ≥ s`*: since `Q` is simple Artinian, `Q_Q` embeds in `M_Q`, which gives
`p ∈ M` with `pR ≅ R_R`; the rank is additive, so `M/pR` has rank `l - s < (q-1) s`,
and `p` together with lifts of `q - 1` generators of `M/pR` generates `M`.

The section *Auxiliary module theory (to be upstreamed to AlgebraicAnalysis)*
collects the application-independent module theory (simple Artinian rings,
module of fractions); it uses no hypothesis beyond (S), (N) and Goldie's
theorem. Its move to AlgebraicAnalysis is pending (`PLAN.md`).
-/

namespace GeneralizedStafford

open MulOpposite nonZeroDivisors
open AlgebraicAnalysis AlgebraicAnalysis.Goldie OreRightLocalization

universe u v

/-! ## Auxiliary module theory (to be upstreamed to AlgebraicAnalysis) -/

section Auxiliary

/-- **Embedding the regular module.** Over a simple Artinian ring `A`, a finitely
generated module `X` with `length A ≤ length X` contains an element `x` with zero
annihilator, i.e. `a ↦ a x` is injective. Both modules are direct sums of copies
of the unique simple module (Wedderburn--Artin), so `A` embeds in `X`. -/
theorem exists_injective_smul_of_length_le {A : Type u} [Ring A] [IsSimpleRing A]
    [IsArtinianRing A] {X : Type v} [AddCommGroup X] [Module A X] [Module.Finite A X]
    (h : Module.length A A ≤ Module.length A X) :
    ∃ x : X, Function.Injective fun a : A => a • x := by
  classical
  obtain ⟨S, hS⟩ := IsAtomic.exists_atom (Submodule A A)
  have : IsSimpleModule A S := isSimpleModule_iff_isAtom.mpr hS
  have hAS : IsIsotypicOfType A A S := IsSimpleRing.isIsotypic A A S
  have hXS : IsIsotypicOfType A X S := by
    intro T _
    have hP := IsSimpleRing.isIsotypic A (A × X)
    have e1 := Submodule.equivMapOfInjective (LinearMap.inl A A X) LinearMap.inl_injective S
    have e2 := Submodule.equivMapOfInjective (LinearMap.inr A A X) LinearMap.inr_injective T
    have : IsSimpleModule A (S.map (LinearMap.inl A A X)) := IsSimpleModule.congr e1.symm
    have : IsSimpleModule A (T.map (LinearMap.inr A A X)) := IsSimpleModule.congr e2.symm
    obtain ⟨e⟩ := hP (S.map (LinearMap.inl A A X)) (T.map (LinearMap.inr A A X))
    exact ⟨e2.trans (e.trans e1.symm)⟩
  obtain ⟨a, ⟨ea⟩⟩ := hAS.linearEquiv_fun
  obtain ⟨b, ⟨eb⟩⟩ := hXS.linearEquiv_fun
  have hab : a ≤ b := by
    have h1 := ea.length_eq
    have h2 := eb.length_eq
    simp only [Module.length_pi, ENat.card_eq_coe_fintype_card, Fintype.card_fin,
      Module.length_eq_one, mul_one] at h1 h2
    rw [h1, h2] at h
    exact_mod_cast h
  let ι : (Fin a → S) →ₗ[A] (Fin b → S) :=
    LinearMap.pi fun j => if hj : (j : ℕ) < a then LinearMap.proj ⟨j, hj⟩ else 0
  have hι : Function.Injective ι := by
    intro g g' hgg
    funext i
    have := congrFun hgg (Fin.castLE hab i)
    simpa [ι, i.2] using this
  let φ : A →ₗ[A] X := eb.symm.toLinearMap ∘ₗ ι ∘ₗ ea.toLinearMap
  have hφ : Function.Injective φ := eb.symm.injective.comp (hι.comp ea.injective)
  refine ⟨φ 1, fun c c' hcc => hφ ?_⟩
  simpa [← map_smul] using hcc


variable {R : Type u} [Ring R] [OreLocalization.OreSet (oppositeSubmonoid R⁰)]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]

/-- **Simplicity argument.** Let `R` be simple, `e ≠ 0` and `U` a
`Q`-submodule of `M_Q` containing the fraction of `m e` for every `m ∈ M`. Then
`U = M_Q`: the `r` with `M r ⊆ U` form a two-sided ideal containing `e`, hence
`1`, and every fraction `m c⁻¹` lies in `U`. -/
theorem eq_top_of_forall_toFractionModule_smul_mem [IsSimpleRing R] {e : R} (he : e ≠ 0)
    (U : Submodule (OppositeQuotientRing R) (FractionModule R M))
    (hU : ∀ m : M, toFractionModule R M (op e • m) ∈ U) : U = ⊤ := by
  -- the two-sided ideal of all `r` with `toFrac(m r) ∈ U` for every `m`
  let J : TwoSidedIdeal R :=
    TwoSidedIdeal.mk' {r | ∀ m : M, toFractionModule R M (op r • m) ∈ U}
    (fun m => by simp)
    (fun hx hy m => by rw [op_add, add_smul, map_add]; exact U.add_mem (hx m) (hy m))
    (fun hx m => by rw [op_neg, neg_smul, map_neg]; exact U.neg_mem (hx m))
    (fun {x y} hy m => by rw [op_mul, mul_smul]; exact hy _)
    (fun {x y} hx m => by
      rw [op_mul, mul_smul, map_smul,
        ← OreModule.oreDiv_one_smul_eq (S := oppositeSubmonoid R⁰)]
      exact U.smul_mem _ (hx m))
  have h1 : (1 : R) ∈ J :=
    IsSimpleRing.one_mem_of_ne_zero_mem J he ((TwoSidedIdeal.mem_mk' ..).mpr hU)
  rw [eq_top_iff]
  intro x _
  induction x using OreLocalization.ind with | _ m c =>
  have hx : m /ₒ c = ((1 : Rᵐᵒᵖ) /ₒ c) • toFractionModule R M m := by
    rw [OreModule.toLocalization_apply, OreLocalization.one_div_smul, one_mul]
  rw [hx]
  refine U.smul_mem _ ?_
  simpa using (TwoSidedIdeal.mem_mk' ..).mp h1 m

/-- **A free cyclic submodule.** If `R` is simple right Noetherian and
`s = rk(R_R) ≤ rk(M)`, then some `p ∈ M` has zero annihilator: `r ↦ p r` is
injective, so `pR ≅ R_R`. Embed `Q_Q` in `M_Q` and clear the denominator of the
image `m c⁻¹` of `1`. -/
theorem exists_injective_toSpanSingleton [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
    [Module.Finite Rᵐᵒᵖ M] (h : goldieRank R R ≤ goldieRank R M) :
    ∃ p : M, Function.Injective (LinearMap.toSpanSingleton Rᵐᵒᵖ M p) := by
  have : Module.Finite (OppositeQuotientRing R) (FractionModule R M) :=
    OreModule.finite (oppositeSubmonoid R⁰) M
  rw [goldieRank_self] at h
  obtain ⟨v, hv⟩ := exists_injective_smul_of_length_le h
  induction v using OreLocalization.ind with | _ m c =>
  refine ⟨m, ?_⟩
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro a ha
  rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at ha
  have h0 : ((a * c) /ₒ (1 : oppositeSubmonoid R⁰)) • (m /ₒ c) = 0 := by
    rw [OreModule.oreDiv_one_smul_eq, mul_smul, OreModule.smul_oreDiv_self,
      ← map_smul, ha, map_zero]
  have h1 : ((a * c) /ₒ (1 : oppositeSubmonoid R⁰) : OppositeQuotientRing R) = 0 :=
    hv (by
      dsimp only
      rw [h0]
      exact (zero_smul (OppositeQuotientRing R) (m /ₒ c : FractionModule R M)).symm)
  have h2 : a * c = 0 := numeratorRingHom_injective (h1.trans (map_zero _).symm)
  exact (Submodule.mem_bot _).mpr
    ((mem_oppositeSubmonoid_nonZeroDivisors.mp c.2).2 a h2)

/-- **Splitting off `R_R`.** If `rk(R_R) ≤ rk(M)`, there is `p ∈ M`
with `rk(M) = rk(R_R) + rk(M/pR)`. -/
theorem exists_goldieRank_eq_add_quotient [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
    [Module.Finite Rᵐᵒᵖ M] (h : goldieRank R R ≤ goldieRank R M) :
    ∃ p : M, goldieRank R M =
      goldieRank R R + goldieRank R (M ⧸ Submodule.span Rᵐᵒᵖ {p}) := by
  obtain ⟨p, hp⟩ := exists_injective_toSpanSingleton h
  refine ⟨p, ?_⟩
  have hexact : Function.Exact (LinearMap.toSpanSingleton Rᵐᵒᵖ M p)
      (Submodule.span Rᵐᵒᵖ {p}).mkQ := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ]
    exact LinearMap.span_singleton_eq_range Rᵐᵒᵖ M p
  rw [goldieRank_eq_add_of_exact hp (Submodule.mkQ_surjective _) hexact, goldieRank_op_self,
    ← goldieRank_self]

/-- **Successive choice** (case `l < s`). Let `e_0, …, e_{n-1}` be
nonzero elements of the simple right Noetherian ring `R` and `rk(M) = l < n`.
There are `m_j ∈ M`, with `m_j = 0` for `j ≥ l`, such that the fractions of the
`m_j e_j` span `M_Q` over `Q`. Each choice raises the length of the span by at
least one until it reaches `l`, by the simplicity argument. -/
theorem exists_span_fraction_eq_top [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
    [Module.Finite Rᵐᵒᵖ M] {n l : ℕ} (e : Fin n → R)
    (he : ∀ j, e j ≠ 0) (hln : l < n) (hM : goldieRank R M = l) :
    ∃ m : Fin n → M, (∀ j : Fin n, l ≤ (j : ℕ) → m j = 0) ∧
      Submodule.span (OppositeQuotientRing R)
        (Set.range fun j => toFractionModule R M (op (e j) • m j)) = ⊤ := by
  classical
  have : Module.Finite (OppositeQuotientRing R) (FractionModule R M) :=
    OreModule.finite (oppositeSubmonoid R⁰) M
  let U : (Fin n → M) → Submodule (OppositeQuotientRing R) (FractionModule R M) := fun m =>
    Submodule.span (OppositeQuotientRing R)
      (Set.range fun j => toFractionModule R M (op (e j) • m j))
  have hlenM : Module.length (OppositeQuotientRing R) (FractionModule R M) = l := hM
  have key : ∀ k ≤ l, ∃ m : Fin n → M, (∀ j : Fin n, k ≤ (j : ℕ) → m j = 0) ∧
      (k : ℕ∞) ≤ Module.length (OppositeQuotientRing R) (U m) := by
    intro k
    induction k with
    | zero => exact fun _ => ⟨0, fun _ _ => rfl, by simp⟩
    | succ k ih =>
      intro hk
      obtain ⟨m, hm0, hmk⟩ := ih (by omega)
      by_cases hlen : ((k + 1 : ℕ) : ℕ∞) ≤ Module.length (OppositeQuotientRing R) (U m)
      · exact ⟨m, fun j hj => hm0 j (by omega), hlen⟩
      have hU : U m ≠ ⊤ := by
        intro htop
        apply hlen
        rw [htop, Module.length_top, hlenM]
        exact_mod_cast hk
      let i : Fin n := ⟨k, by omega⟩
      obtain ⟨m', hm'⟩ : ∃ m' : M, toFractionModule R M (op (e i) • m') ∉ U m := by
        by_contra! h
        exact hU (eq_top_of_forall_toFractionModule_smul_mem (he i) _ h)
      refine ⟨Function.update m i m', fun j hj => ?_, ?_⟩
      · have hji : j ≠ i := fun h => by rw [h] at hj; simp [i] at hj
        rw [Function.update_of_ne hji]
        exact hm0 j (by omega)
      have hlt : U m < U (Function.update m i m') := by
        refine lt_of_le_of_ne (Submodule.span_le.mpr ?_) ?_
        · rintro _ ⟨j, rfl⟩
          by_cases hj : j = i
          · rw [hj]
            dsimp only
            rw [hm0 i le_rfl, smul_zero, map_zero]
            exact zero_mem _
          · exact Submodule.subset_span ⟨j, by simp [Function.update_of_ne hj]⟩
        · intro heq
          apply hm'
          rw [heq]
          exact Submodule.subset_span ⟨i, by simp⟩
      have h1 := Submodule.height_strictMono hlt
      rw [← Module.length_submodule, ← Module.length_submodule] at h1
      push_cast
      exact Order.add_one_le_of_lt (lt_of_le_of_lt hmk h1)
  obtain ⟨m, hm0, hml⟩ := key l le_rfl
  refine ⟨m, hm0, ?_⟩
  by_contra hne
  have := Submodule.length_lt hne
  rw [hlenM] at this
  exact (lt_of_le_of_lt hml this).false

end Auxiliary

/-! ## The upper bound -/

section UpperBound

variable {R : Type u} [Ring R] [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
  [OreLocalization.OreSet (oppositeSubmonoid R⁰)]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable {k : Type*} [Field k] [Infinite k] [Algebra k R]

include k in
/-- **Base case `l < s`.** Assume (S), (N), (Z) and
(H_all). A finitely generated right module `M` with `rk(M) < rk(R_R)` is cyclic.
With `m_j` from the successive choice, `L = Σ m_j e_j R` has `L_Q = M_Q`, so
`M/L` is Goldie torsion; C.1 in `M/L` with tail `e_l` gives `h` with
`M/L = (h e_l + L)R`, and `y = p + h f_l` with `p = Σ m_j f_j` satisfies
`y r_j = m_j e_j` (`j ≠ l`) and `y r_l = h e_l`, hence `M = yR`.

Indexing: the idempotents are indexed by `Fin n` from `0`, so the `l` chosen
spans use the indices `0, …, l - 1` and the free index is `l : Fin n` itself
(`l < n` because `rk(M) < rk(R_R)`). In one-based indexing the free index is
`l + 1`; the proof here uses the offset `0` in place of `p r_{l+1}`, since `m_l = 0` and hence `p r_l = 0` here. -/
theorem cyclic_of_goldieRank_lt (hall : PrincipalQuotientsFinite R) [Module.Finite Rᵐᵒᵖ M]
    (hM : goldieRank R M < goldieRank R R) : ∃ y : M, Submodule.span Rᵐᵒᵖ {y} = ⊤ := by
  classical
  obtain ⟨n, E, c, t, f, r, hn, -, -, -, -, -, -, hfr, -, hne⟩ :=
    exists_idempotent_denominators (R := R)
  obtain ⟨l, hl⟩ := ENat.ne_top_iff_exists.mp (goldieRank_ne_top (R := R) (M := M))
  have hln : l < n := by
    rw [← hn, ← hl] at hM
    exact_mod_cast hM
  let e : Fin n → R := fun j => f j * r j
  obtain ⟨m, hm0, hspan⟩ := exists_span_fraction_eq_top e hne hln hl.symm
  let L : Submodule Rᵐᵒᵖ M := Submodule.span Rᵐᵒᵖ (Set.range fun j => op (e j) • m j)
  have htor : IsGoldieTorsion R (M ⧸ L) := by
    rw [← goldieRank_eq_zero_iff]
    have hsurj : Function.Surjective
        (OreModule.localizationMap (oppositeSubmonoid R⁰) L.subtype) := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← hspan, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨OreModule.toLocalization _ L ⟨_, Submodule.subset_span ⟨j, rfl⟩⟩, rfl⟩
    have hinj := OreModule.localizationMap_injective (S := oppositeSubmonoid R⁰)
      L.injective_subtype
    have hLM : goldieRank R L = goldieRank R M :=
      (LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩).length_eq
    have hadd := goldieRank_eq_add_of_exact (R := R) L.injective_subtype L.mkQ_surjective
      (LinearMap.exact_subtype_mkQ L)
    rw [hLM, ← hl] at hadd
    generalize goldieRank R (M ⧸ L) = x at hadd ⊢
    induction x using ENat.recTopCoe with
    | top => simp at hadd
    | coe x => norm_cast at hadd ⊢; omega
  let i : Fin n := ⟨l, hln⟩
  obtain ⟨hbar, hh⟩ :=
    prescribed_cyclic_of_hAll (k := k) (M := M ⧸ L) hall htor 0 (hne i)
  obtain ⟨h, rfl⟩ := L.mkQ_surjective hbar
  let p : M := ∑ j, op (f j) • m j
  have hp : ∀ j, op (r j) • p = op (e j) • m j := by
    intro j
    simp only [p, Finset.smul_sum, smul_smul, ← op_mul]
    rw [Finset.sum_eq_single j (fun b _ hb => by rw [hfr b j hb, op_zero, zero_smul])
      (by simp)]
  let y : M := p + op (f i) • h
  have hyi : op (r i) • y = op (e i) • h := by
    rw [smul_add, hp, hm0 i le_rfl, smul_zero, zero_add, smul_smul, ← op_mul]
  have hLy : L ≤ Submodule.span Rᵐᵒᵖ {y} := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    by_cases hj : j = i
    · rw [hj]
      dsimp only
      rw [hm0 i le_rfl, smul_zero]
      exact zero_mem _
    · have : op (r j) • y = op (e j) • m j := by
        rw [smul_add, hp, smul_smul, ← op_mul, hfr i j (Ne.symm hj), op_zero, zero_smul,
          add_zero]
      dsimp only
      rw [← this]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self y)
  refine ⟨y, ?_⟩
  have htop : L ⊔ Submodule.span Rᵐᵒᵖ {y} = ⊤ := by
    rw [← Submodule.map_mkQ_eq_top, eq_top_iff, ← hh, Submodule.span_le,
      Set.singleton_subset_iff, zero_add, ← map_smul, ← hyi]
    exact Submodule.mem_map_of_mem
      (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self y))
  rwa [sup_eq_right.mpr hLy] at htop

include k in
/-- **Upper bound, rank form.** Assume (S), (N), (Z), (H_all). For
every `q`, a finitely generated right module `M` with `rk(M) < q · rk(R_R)` is
generated by `q` elements. Induction on `q`: if `rk(M) < rk(R_R)` then `M` is
cyclic; otherwise split off `pR ≅ R_R` and apply the induction hypothesis to
`M/pR`. -/
theorem spanRank_le_of_goldieRank_lt (hall : PrincipalQuotientsFinite R) (q : ℕ) :
    ∀ (M : Type v) [AddCommGroup M] [Module Rᵐᵒᵖ M] [Module.Finite Rᵐᵒᵖ M],
      goldieRank R M < q * goldieRank R R →
        ∃ g : Finset M, g.card ≤ q ∧ Submodule.span Rᵐᵒᵖ (g : Set M) = ⊤ := by
  classical
  induction q with
  | zero => intro M _ _ _ h; simp at h
  | succ q ih =>
    intro M _ _ _ hM
    by_cases hlt : goldieRank R M < goldieRank R R
    · -- Base case `l < s`: `M` is cyclic.
      obtain ⟨y, hy⟩ := cyclic_of_goldieRank_lt (k := k) hall hlt
      exact ⟨{y}, by simp, by simpa using hy⟩
    -- Step: split off a copy `pR ≅ R_R`; the rank drops by `s`.
    obtain ⟨p, hadd⟩ := exists_goldieRank_eq_add_quotient (not_lt.mp hlt)
    let P := Submodule.span Rᵐᵒᵖ {p}
    have hN : goldieRank R (M ⧸ P) < q * goldieRank R R := by
      obtain ⟨s, hs⟩ := ENat.ne_top_iff_exists.mp (goldieRank_self_ne_top (R := R))
      obtain ⟨x, hx⟩ := ENat.ne_top_iff_exists.mp (goldieRank_ne_top (R := R) (M := M ⧸ P))
      rw [hadd, ← hs, ← hx] at hM
      rw [← hs, ← hx]
      norm_cast at hM ⊢
      nlinarith
    -- Induction: `M/pR` is generated by `q` elements; lift them and add `p`.
    obtain ⟨g, hg, hspan⟩ := ih (M ⧸ P) hN
    let lift : M ⧸ P → M := Function.surjInv P.mkQ_surjective
    refine ⟨insert p (g.image lift), ?_, ?_⟩
    · calc (insert p (g.image lift)).card ≤ (g.image lift).card + 1 :=
          Finset.card_insert_le _ _
        _ ≤ g.card + 1 := by gcongr; exact Finset.card_image_le
        _ ≤ q + 1 := by omega
    · rw [Finset.coe_insert, Submodule.span_insert, ← Submodule.map_mkQ_eq_top,
        Submodule.map_span, Finset.coe_image, ← Set.image_comp,
        show ⇑P.mkQ ∘ lift = id from funext (Function.surjInv_eq P.mkQ_surjective),
        Set.image_id, hspan]

end UpperBound

/-! ## Corollary C.3 in uniform-dimension form -/

section CorollaryC3

variable {R : Type u} [Ring R] [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable {k : Type*} [Field k] [Infinite k] [Algebra k R]

/-- **C.3, lower bound** `⌈ρ(M)⌉ ≤ μ(M)`. Assume (S),
(N). If `M` is generated by a set of at most `m` elements, `M/t(M)` contains a
direct sum of `ℓ` nonzero submodules and `R_R` contains no direct sum of `s + 1`
nonzero right ideals, then `ℓ ≤ m s`.

This is a thin wrapper: the proof is AlgebraicAnalysis
`Goldie.le_mul_of_uniformDim` after supplying the
Ore set of regular elements from Goldie's theorem. -/
theorem le_mul_of_span_eq_top {m ℓ s : ℕ} (g : Finset M) (hg : g.card ≤ m)
    (hspan : Submodule.span Rᵐᵒᵖ (g : Set M) = ⊤)
    (hℓ : Module.UniformDimGE Rᵐᵒᵖ (M ⧸ goldieTorsionPart R M) ℓ)
    (hs : Module.UniformDimLE Rᵐᵒᵖ R s) : ℓ ≤ m * s := by
  obtain ⟨_⟩ := nonempty_oreSet_oppositeSubmonoid (R := R)
  exact le_mul_of_uniformDim g hg hspan hℓ hs

include k in
/-- **C.3, upper bound** `μ(M) ≤ ⌊ρ(M)⌋ + 1`. Assume
(S), (N), (Z) and (H_all), and let `M` be finitely generated. If `M/t(M)` contains
no direct sum of `ℓ + 1` nonzero submodules, `R_R` contains a direct sum of `s`
nonzero right ideals and `ℓ < q s`, then `M` is generated by `q` elements:
`rk(M) ≤ ℓ < q s ≤ q · rk(R_R)`. -/
theorem exists_span_eq_top_of_lt_mul (hall : PrincipalQuotientsFinite R)
    [Module.Finite Rᵐᵒᵖ M] {q ℓ s : ℕ} (hℓ : Module.UniformDimLE Rᵐᵒᵖ (M ⧸ goldieTorsionPart R M) ℓ)
    (hs : Module.UniformDimGE Rᵐᵒᵖ R s) (hq : ℓ < q * s) :
    ∃ g : Finset M, g.card ≤ q ∧ Submodule.span Rᵐᵒᵖ (g : Set M) = ⊤ := by
  obtain ⟨_⟩ := nonempty_oreSet_oppositeSubmonoid (R := R)
  refine spanRank_le_of_goldieRank_lt (k := k) hall q M ?_
  calc goldieRank R M ≤ ℓ := uniformDimLE_quotient_iff.mp hℓ
    _ < ((q * s : ℕ) : ℕ∞) := by exact_mod_cast hq
    _ = q * s := by push_cast; rfl
    _ ≤ q * goldieRank R R := by gcongr; exact uniformDimGE_self_iff.mp hs

end CorollaryC3

